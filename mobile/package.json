{
  "name": "eli-command-center",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~57.0.22",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-updates": "~57.0.22",
    "expo-dev-client": "~57.0.19",
    "expo-haptics": "~57.0.3",
    "react-native-safe-area-context": "~5.7.0",
    "@react-native-community/netinfo": "12.0.1",
    "@expo/vector-icons": "^15.0.2",
    "react-native-web": "~0.21.0",
    "react-dom": "19.2.3",
    "@react-native-google-signin/google-signin": "16.1.5",
    "expo-speech-recognition": "~57.0.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
    "jest-expo": "~57.0.5",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@testing-library/react-native": "^13.3.3",
    "react-test-renderer": "19.2.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "export:ios": "expo export --platform ios",
    "verify": "npm run typecheck && npm test && npm run export:ios",
    "release:check": "node scripts/release-check.cjs",
    "eas-build-post-install": "npm run release:check",
    "build:ios": "npm run release:check && eas build --platform ios --profile production",
    "submit:ios": "eas submit --platform ios --profile production"
  },
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.ts",
      "**/__tests__/**/*.test.tsx"
    ]
  }
}
